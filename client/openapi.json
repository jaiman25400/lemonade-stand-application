  "info": {
    "title": "Lemonade Stand API",
    "description": "Beverage catalog and order processing",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Size": {
        "type": "object",
        "properties": {}
      },
      "CreateSizeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Small",
            "maxLength": 40
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateSizeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Small",
            "maxLength": 40
          }
        }
      },
      "BeverageSizeOfferingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "size-uuid"
          },
          "name": {
            "type": "string",
            "example": "Small"
          },
          "price": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "id",
          "name",
          "price"
        ]
      },
      "BeverageResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Classic Lemonade"
          },
          "sizes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BeverageSizeOfferingDto"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "sizes",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateBeverageDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Classic Lemonade",
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateBeverageDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Classic Lemonade",
            "maxLength": 120
          }
        }
      },
      "AddBeverageSizeDto": {
        "type": "object",
        "properties": {
          "sizeId": {
            "type": "string",
            "format": "uuid"
          },
          "price": {
            "type": "number",
            "example": 2,
            "minimum": 0
          }
        },
        "required": [
          "sizeId",
          "price"
        ]
      },
      "UpdateBeverageSizePriceDto": {
        "type": "object",
        "properties": {
          "price": {
            "type": "number",
            "example": 2.5,
            "minimum": 0
          }
        },
        "required": [
          "price"
        ]
      },
      "CreateOrderItemDto": {
        "type": "object",
        "properties": {
          "beverageId": {
            "type": "string",
            "format": "uuid"
          },
          "sizeId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "example": 2,
            "minimum": 1
          }
        },
        "required": [
          "beverageId",
          "sizeId",
          "quantity"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "customerName": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+1 416 555 0100"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemDto"
            }
          }
        },
        "required": [
          "customerName",
          "items"
        ]
      },
      "OrderItemResponseDto": {
        "type": "object",
        "properties": {
          "beverageName": {
            "type": "string"
          },
          "sizeName": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unitPrice": {
            "type": "number",
            "example": 2
          },
          "lineTotal": {
            "type": "number",
            "example": 4
          }
        },
        "required": [
          "beverageName",
          "sizeName",
          "quantity",
          "unitPrice",
          "lineTotal"
        ]
      },
      "OrderResponseDto": {
        "type": "object",
        "properties": {
          "confirmationNumber": {
            "type": "string",
            "example": "LS-A1B2C3D4"
          },
          "customerName": {
            "type": "string"
          },
          "phone": {
            "type": "object"
          },
          "email": {
            "type": "object"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemResponseDto"
            }
          },
          "total": {
            "type": "number",
            "example": 6
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "confirmationNumber",
          "customerName",
          "items",
          "total",
          "createdAt"
        ]
      }
    }
  }
}
